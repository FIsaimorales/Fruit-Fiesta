        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DataManager = require(script.DataManager)
local IncomeService = require(script.IncomeService)
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

export type Plant = GameConfig.Plant

-- Create or retrieve RemoteEvents folder in ReplicatedStorage
local remotes = ReplicatedStorage:FindFirstChild("Remotes") :: Folder
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = "Remotes"
	remotes.Parent = ReplicatedStorage
end

local function getOrCreateRemote(name: string): RemoteEvent
	local existing = remotes:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end

-- Server → Client: push full player state
local _updatePlayerData = getOrCreateRemote("UpdatePlayerData")

-- Server → Client: lightweight tick update for coins & income/s
local _updateCoins = getOrCreateRemote("UpdateCoins")

-- Server → Client: notify egg gacha reveal result
local eggOpened = getOrCreateRemote("EggOpened")

-- Client → Server: open an egg
local openEgg = getOrCreateRemote("OpenEgg")

-- Client → Server: place a plant from inventory into a plot slot
local placePlant = getOrCreateRemote("PlacePlant")

-- Client → Server: remove plant from plot slot back to inventory
local removePlant = getOrCreateRemote("RemovePlant")

-- Client → Server: auto equip best plants
local autoEquipBest = getOrCreateRemote("AutoEquipBest")

-- ── Debounce anti-spam helper ────────────────────────────────────────────────
local lastAction: { [number]: number } = {}

local function checkRateLimit(player: Player, minDelay: number): boolean
	local now = os.clock()
	local last = lastAction[player.UserId] or 0
	if (now - last) < minDelay then
		return false
	end
	lastAction[player.UserId] = now
	return true
end

-- ── Egg gacha logic (rarity rolled first according to EGG_WEIGHTS) ─────────────

local function rollRarity(): number
	local totalWeight = 0
	for _, w in GameConfig.EGG_WEIGHTS do
		totalWeight += w
	end

	local roll = math.random() * totalWeight
	local cumulative = 0
	for id, w in GameConfig.EGG_WEIGHTS do
		cumulative += w
		if roll <= cumulative then
			return id
		end
	end
	return 1
end

local function rollEgg(): (string, number)
	local rarityId = rollRarity()
	local eligibleSpecies = GameConfig.getSpeciesForRarity(rarityId)

	local selectedSpecies = eligibleSpecies[math.random(1, #eligibleSpecies)]
	return selectedSpecies.name, rarityId
end

openEgg.OnServerEvent:Connect(function(player: Player)
	if not checkRateLimit(player, 0.2) then
		return
	end

	local data = DataManager.get(player)
	if not data then
		return
	end
	if data.coins < GameConfig.EGG_COST then
		return
	end

	data.coins -= GameConfig.EGG_COST

	local speciesName, rarityId = rollEgg()
	local newPlant: Plant = { speciesName = speciesName, rarityId = rarityId }
	table.insert(data.plants, newPlant)

	-- Notify client to play the gacha reveal cinematic
	eggOpened:FireClient(player, newPlant)

	IncomeService.pushUpdate(player)
end)

-- ── Plot management ───────────────────────────────────────────────────────────

placePlant.OnServerEvent:Connect(function(player: Player, inventoryIndex: any, slotIndex: any)
	if not checkRateLimit(player, 0.05) then
		return
	end

	-- Strict integer and type validation
	if typeof(inventoryIndex) ~= "number" or typeof(slotIndex) ~= "number" then
		return
	end
	if inventoryIndex ~= math.floor(inventoryIndex) or slotIndex ~= math.floor(slotIndex) then
		return
	end

	local data = DataManager.get(player)
	if not data then
		return
	end

	if slotIndex < 1 or slotIndex > GameConfig.PLOT_SIZE then
		return
	end
	if inventoryIndex < 1 or inventoryIndex > #data.plants then
		return
	end

	-- Ensure target slot is empty
	local currentSlot = data.plot[slotIndex]
	if currentSlot and currentSlot ~= false then
		return
	end

	local plant = table.remove(data.plants, inventoryIndex)
	if not plant then
		return
	end

	data.plot[slotIndex] = plant
	IncomeService.pushUpdate(player)
end)

removePlant.OnServerEvent:Connect(function(player: Player, slotIndex: any)
	if not checkRateLimit(player, 0.05) then
		return
	end

	-- Strict integer and type validation
	if typeof(slotIndex) ~= "number" or slotIndex ~= math.floor(slotIndex) then
		return
	end

	local data = DataManager.get(player)
	if not data then
		return
	end

	if slotIndex < 1 or slotIndex > GameConfig.PLOT_SIZE then
		return
	end

	local slot = data.plot[slotIndex]
	if not slot or slot == false or type(slot) ~= "table" then
		return
	end

	data.plot[slotIndex] = false
	table.insert(data.plants, slot)

	IncomeService.pushUpdate(player)
end)

-- Auto equip best plants into the plot
autoEquipBest.OnServerEvent:Connect(function(player: Player)
	if not checkRateLimit(player, 0.2) then
		return
	end

	local data = DataManager.get(player)
	if not data then
		return
	end

	-- Collect all plants
	local allPlants: { Plant } = {}
	for _, slot in data.plot do
		if slot and type(slot) == "table" then
			table.insert(allPlants, slot)
		end
	end
	for _, plant in data.plants do
		table.insert(allPlants, plant)
	end

	-- Sort by income descending
	table.sort(allPlants, function(a, b)
		local incomeA = GameConfig.getIncome(a.speciesName, a.rarityId)
		local incomeB = GameConfig.getIncome(b.speciesName, b.rarityId)
		if incomeA == incomeB then
			return a.rarityId > b.rarityId
		end
		return incomeA > incomeB
	end)

	-- Fill plot with best
	local newPlot: { Plant | boolean } = {}
	local newPlants: { Plant } = {}

	for i = 1, GameConfig.PLOT_SIZE do
		if allPlants[i] then
			newPlot[i] = allPlants[i]
		else
			newPlot[i] = false
		end
	end

	for i = GameConfig.PLOT_SIZE + 1, #allPlants do
		table.insert(newPlants, allPlants[i])
	end

	data.plot = newPlot
	data.plants = newPlants

	IncomeService.pushUpdate(player)
end)

-- ── Player lifecycle ──────────────────────────────────────────────────────────

local function setupPlayer(player: Player)
	local data = DataManager.load(player)
	if data then
		IncomeService.pushUpdate(player)
	end
end

Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(player: Player)
	lastAction[player.UserId] = nil
end)

for _, player in Players:GetPlayers() do
	task.spawn(setupPlayer, player)
end

IncomeService.init(remotes)

print("[Server] FruitGarden initialized with modern UI remotes & AutoEquip.")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">DataManager</string>
          <string name="Source"><![CDATA[--!strict
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

export type PlayerData = GameConfig.PlayerData
export type Plant = GameConfig.Plant

local DataManager = {}

local store = DataStoreService:GetDataStore(GameConfig.DATASTORE_NAME)

-- In-memory cache: userId → data table
local cache: { [number]: PlayerData } = {}

-- Create a fresh default data table with starter coins and plant
local function createDefaultData(): PlayerData
	local initialPlot: { Plant | boolean } = {}
	for i = 1, GameConfig.PLOT_SIZE do
		if i == 1 and GameConfig.STARTING_PLANT then
			initialPlot[i] = {
				speciesName = GameConfig.STARTING_PLANT.speciesName,
				rarityId = GameConfig.STARTING_PLANT.rarityId,
			}
		else
			initialPlot[i] = false -- false = empty slot (serializable in JSON)
		end
	end

	return {
		coins = GameConfig.STARTING_COINS or 150,
		plants = {},
		plot = initialPlot,
		rebirths = 0,
	}
end

local function deepCopy(t: any): any
	if type(t) ~= "table" then
		return t
	end
	local copy = {}
	for k, v in t do
		copy[k] = deepCopy(v)
	end
	return copy
end

-- Retry wrapper for DataStore operations
local function retryDataStore<T>(attempts: number, delaySec: number, operation: () -> T): (boolean, any)
	local success = false
	local result: any = nil
	for attempt = 1, attempts do
		success, result = pcall(operation)
		if success then
			return true, result
		end
		if attempt < attempts then
			task.wait(delaySec * attempt)
		end
	end
	return false, result
end

function DataManager.load(player: Player): PlayerData?
	local key = "player_" .. player.UserId
	local success, result = retryDataStore(3, 1, function()
		return store:GetAsync(key)
	end)

	if not success then
		warn("[DataManager] CRITICAL: Fallo al cargar datos para " .. player.Name .. " (" .. player.UserId .. "): " .. tostring(result))
		-- Desconectar al jugador preventivamente para evitar que un auto-guardado sobrescriba sus datos reales con datos vacíos
		player:Kick("Error al cargar tus datos. Por favor reingresa al juego.")
		return nil
	end

	local data: PlayerData
	if result and type(result) == "table" then
		-- Jugador existente: fusionar con defaults por si se agregaron nuevos campos
		local defaults = createDefaultData()
		data = deepCopy(defaults)
		for k, v in result do
			(data :: any)[k] = v
		end
	else
		-- Nuevo jugador: asignar datos iniciales
		data = createDefaultData()
	end

	-- Asegurar que el array del plot tenga la longitud correcta
	for i = 1, GameConfig.PLOT_SIZE do
		if data.plot[i] == nil then
			data.plot[i] = false
		end
	end

	cache[player.UserId] = data
	return data
end

function DataManager.save(player: Player): boolean
	local data = cache[player.UserId]
	if not data then
		return false
	end

	local key = "player_" .. player.UserId
	local success, err = retryDataStore(3, 1, function()
		store:UpdateAsync(key, function(_oldData)
			return data
		end)
		return nil
	end)

	if not success then
		warn("[DataManager] Error al guardar datos para " .. player.Name .. " (" .. player.UserId .. "): " .. tostring(err))
		return false
	end

	return true
end

function DataManager.get(player: Player): PlayerData?
	return cache[player.UserId]
end

function DataManager.unload(player: Player)
	if cache[player.UserId] then
		DataManager.save(player)
		cache[player.UserId] = nil
	end
end

-- Auto-guardado periódico cada 60 segundos con distribución escalonada para evitar picos de escritura
task.spawn(function()
	while true do
		task.wait(60)
		for _, player in Players:GetPlayers() do
			if cache[player.UserId] then
				DataManager.save(player)
				task.wait(0.2) -- Stagger saves
			end
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	DataManager.unload(player)
end)

-- BindToClose: Esperar a que todos los guardados finalicen antes de que el servidor se apague
game:BindToClose(function()
	local playersToSave: { Player } = {}

	for _, player in Players:GetPlayers() do
		if cache[player.UserId] then
			table.insert(playersToSave, player)
		end
	end

	if #playersToSave == 0 then
		return
	end

	print(string.format("[DataManager] Servidor cerrándose: Guardando datos de %d jugadores...", #playersToSave))

	-- Rastrear threads en lugar de contador compartido (evita race condition)
	local threads: { thread } = {}
	for _, player in playersToSave do
		table.insert(threads, task.spawn(function()
			DataManager.save(player)
		end))
	end

	-- Esperar con timeout máximo de 25 segundos (Roblox corta a los 30s)
	local startTime = os.clock()
	while (os.clock() - startTime) < 25 do
		local allDone = true
		for _, thread in threads do
			if coroutine.status(thread) ~= "dead" then
				allDone = false
				break
			end
		end
		if allDone then break end
		task.wait(0.05)
	end

	print("[DataManager] Guardado de cierre finalizado.")
end)

return DataManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">IncomeService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local DataManager = require(script.Parent.DataManager)

export type PlayerData = GameConfig.PlayerData

local IncomeService = {}

local updatePlayerRemote: RemoteEvent
local updateCoinsRemote: RemoteEvent

-- Calculates total coins/s for a player's current plot
function IncomeService.calcIncome(data: PlayerData): number
	local total = 0
	for _, slot in data.plot do
		if slot and type(slot) == "table" then
			total += GameConfig.getIncome(slot.speciesName, slot.rarityId)
		end
	end
	return total
end

function IncomeService.init(remotes: Folder)
	updatePlayerRemote = remotes:WaitForChild("UpdatePlayerData", 10) :: RemoteEvent
	updateCoinsRemote = remotes:WaitForChild("UpdateCoins", 10) :: RemoteEvent
	if not updatePlayerRemote or not updateCoinsRemote then
		error("[IncomeService] No se encontraron los RemoteEvents necesarios en Remotes.")
	end

	task.spawn(function()
		while true do
			task.wait(GameConfig.INCOME_TICK_RATE)
			for _, player in Players:GetPlayers() do
				local data = DataManager.get(player)
				if not data then
					continue
				end

				local income = IncomeService.calcIncome(data)
				if income > 0 then
					data.coins += income
				end

				-- Enviar únicamente actualización ligera de monedas e income/s (optimización de red)
				updateCoinsRemote:FireClient(player, data.coins, income)
			end
		end
	end)
end

-- Called when a player's plot/inventory changes mid-tick or upon initial load
function IncomeService.pushUpdate(player: Player)
	local data = DataManager.get(player)
	if not data then
		return
	end

	local income = IncomeService.calcIncome(data)
	updatePlayerRemote:FireClient(player, {
		coins = data.coins,
		plants = data.plants,
		plot = data.plot,
		rebirths = data.rebirths,
		incomePerSecond = income,
	})
end

return IncomeService
]]></string>
