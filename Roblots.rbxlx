        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">UIEffects</string>
            <string name="Source"><![CDATA[--!strict
local TweenService = game:GetService("TweenService")
local SoundManager = require(script.Parent.SoundManager)

local UIEffects = {}

function UIEffects.playSound(name: string, pitch: number?, volumeScale: number?)
	SoundManager.playSound(name, pitch, volumeScale)
end

-- Adds elastic squash & stretch animations to any GuiButton
function UIEffects.applyButtonBounce(button: GuiButton, baseScale: number?)
	local scale = baseScale or 1.0
	local uiScale = button:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Scale = scale
		uiScale.Parent = button
	end

	local hoverTween: Tween? = nil
	local pressTween: Tween? = nil

	button.MouseEnter:Connect(function()
		if hoverTween then
			hoverTween:Cancel()
		end
		hoverTween = TweenService:Create(
			uiScale,
			TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Scale = scale * 1.06 }
		)
		hoverTween:Play()
		SoundManager.playSound("Pop", 1.2, 0.4)
	end)

	button.MouseLeave:Connect(function()
		if hoverTween then
			hoverTween:Cancel()
		end
		hoverTween = TweenService:Create(
			uiScale,
			TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Scale = scale }
		)
		hoverTween:Play()
	end)

	button.MouseButton1Down:Connect(function()
		if pressTween then
			pressTween:Cancel()
		end
		pressTween = TweenService:Create(
			uiScale,
			TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Scale = scale * 0.93 }
		)
		pressTween:Play()
		SoundManager.playSound("Click", 1.0, 0.6)
	end)

	button.MouseButton1Up:Connect(function()
		if pressTween then
			pressTween:Cancel()
		end
		pressTween = TweenService:Create(
			uiScale,
			TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Scale = scale * 1.05 }
		)
		pressTween:Play()
	end)
end

-- Animate modal popup opening (Bouncy Spring)
function UIEffects.openModal(modalFrame: GuiObject, backdrop: GuiObject?)
	local uiScale = modalFrame:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Parent = modalFrame
	end

	uiScale.Scale = 0.5
	modalFrame.Visible = true

	if backdrop then
		backdrop.Visible = true
		backdrop.BackgroundTransparency = 1
		TweenService:Create(
			backdrop,
			TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ BackgroundTransparency = 0.55 }
		):Play()
	end

	SoundManager.playSound("Pop", 1.0, 0.6)

	local tween = TweenService:Create(
		uiScale,
		TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Scale = 1.0 }
	)
	tween:Play()
end

-- Animate modal closing
function UIEffects.closeModal(modalFrame: GuiObject, backdrop: GuiObject?, onComplete: (() -> ())?)
	local uiScale = modalFrame:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Parent = modalFrame
	end

	if backdrop then
		TweenService:Create(
			backdrop,
			TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ BackgroundTransparency = 1 }
		):Play()
	end

	local tween = TweenService:Create(
		uiScale,
		TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Scale = 0.6 }
	)
	tween:Play()

	tween.Completed:Connect(function()
		modalFrame.Visible = false
		if backdrop then
			backdrop.Visible = false
		end
		if onComplete then
			onComplete()
		end
	end)
end

-- Shake animation for Gacha egg suspense
function UIEffects.shakeObject(object: GuiObject, duration: number, intensity: number)
	task.spawn(function()
		local originalPos = object.Position
		local startTime = os.clock()
		while (os.clock() - startTime) < duration do
			local offsetX = (math.random() - 0.5) * intensity * 2
			local offsetY = (math.random() - 0.5) * intensity * 2
			object.Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset + offsetX, originalPos.Y.Scale, originalPos.Y.Offset + offsetY)
			task.wait(0.04)
		end
		object.Position = originalPos
	end)
end

-- Spawns floating animated +$ text popping upward
function UIEffects.spawnFloatingText(parent: Instance, text: string, startPos: UDim2, color: Color3, fontSize: number?)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0, 220, 0, 36)
	label.Position = startPos
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.Font = Enum.Font.GothamBlack
	label.TextSize = fontSize or 22
	label.TextStrokeTransparency = 0.2
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.ZIndex = 50
	label.Parent = parent

	local targetPos = UDim2.new(startPos.X.Scale, startPos.X.Offset, startPos.Y.Scale, startPos.Y.Offset - 50)

	local tween = TweenService:Create(
		label,
		TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			Position = targetPos,
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		}
	)
	tween:Play()
	tween.Completed:Connect(function()
		label:Destroy()
	end)
end

return UIEffects
]]></string>
          </Properties>
        </Item>
